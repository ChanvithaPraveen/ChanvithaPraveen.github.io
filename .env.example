# EmailJS — used by the Contact form to send real email notifications.
# Sign up free: https://www.emailjs.com/
# See EMAIL_SETUP.md for the full step-by-step guide.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Chana AI — portfolio assistant powered by Google Gemini.
# Deploy the Cloudflare Worker from cloudflare-worker/chana-proxy.js
# See CHANA_SETUP.md for the full deployment guide.

NEXT_PUBLIC_CHANA_ENDPOINT=https://your-worker.your-subdomain.workers.dev
